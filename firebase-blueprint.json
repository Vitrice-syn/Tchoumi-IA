{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile information",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Unique user ID" },
        "email": { "type": "string", "format": "email" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string", "format": "uri" },
        "plan": { "type": "string", "enum": ["free", "plus", "pro", "ultra"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email"]
    },
    "ProUser": {
      "title": "ProUser",
      "description": "Subscription record maintained by founder",
      "type": "object",
      "properties": {
        "email": { "type": "string", "format": "email" },
        "plan": { "type": "string", "enum": ["plus", "pro", "ultra"] },
        "activatedAt": { "type": "integer" },
        "status": { "type": "string", "enum": ["active", "inactive"] },
        "notes": { "type": "string" }
      },
      "required": ["email", "status"]
    },
    "SubscriptionRequest": {
      "title": "SubscriptionRequest",
      "description": "Client subscription request submitted from upgrade form",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "fullName": { "type": "string", "minLength": 2, "maxLength": 120 },
        "email": { "type": "string", "format": "email", "maxLength": 160 },
        "phone": { "type": "string", "minLength": 6, "maxLength": 40 },
        "paymentMethod": { "type": "string", "enum": ["orange_money", "mtn_momo", "card", "whatsapp"] },
        "plan": { "type": "string", "enum": ["plus", "pro", "ultra"] },
        "priceLabel": { "type": "string", "maxLength": 60 },
        "notes": { "type": "string", "maxLength": 500 },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected"] },
        "uid": { "type": "string" },
        "createdAt": { "type": "integer" },
        "processedAt": { "type": "integer" }
      },
      "required": ["fullName", "email", "phone", "plan", "status", "createdAt"]
    },
    "Chat": {
      "title": "Chat",
      "description": "A conversation session",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "createdAt": { "type": "integer" },
        "updatedAt": { "type": "integer" }
      },
      "required": ["id", "userId", "createdAt"]
    },
    "Message": {
      "title": "Message",
      "description": "A single message in a chat",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "chatId": { "type": "string" },
        "role": { "type": "string", "enum": ["user", "assistant"] },
        "content": { "type": "string" },
        "timestamp": { "type": "integer" }
      },
      "required": ["id", "chatId", "role", "content", "timestamp"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profile documents"
    },
    "/pro_users/{email}": {
      "schema": "ProUser",
      "description": "Subscribed user license records"
    },
    "/subscription_requests/{requestId}": {
      "schema": "SubscriptionRequest",
      "description": "Client subscription requests awaiting founder activation"
    },
    "/users/{userId}/chats/{chatId}": {
      "schema": "Chat",
      "description": "User's chat sessions"
    },
    "/users/{userId}/chats/{chatId}/messages/{messageId}": {
      "schema": "Message",
      "description": "Messages within a specific chat"
    }
  }
}
